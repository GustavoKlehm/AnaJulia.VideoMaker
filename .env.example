PORT=3002

# API (Settings → API)
VITE_SUPABASE_URL=https://bkknluhlyqmfhiazwslg.supabase.co
VITE_SUPABASE_ANON_KEY=

# Hero (Storage público: bucket media)
VITE_HERO_VIDEO_URL=https://bkknluhlyqmfhiazwslg.supabase.co/storage/v1/object/public/media/hero_cinematographic.MOV
SUPABASE_URL=https://bkknluhlyqmfhiazwslg.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Estúdio: o service role é obrigatório para cadastrar/promover em /estudio/equipe.
# Desligue o cadastro público em Authentication → Providers → Email.

# Área do cliente
# Token que o ExPx usa para cadastrar clientes e enviar planos (mínimo 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# O mesmo valor vai no .env do ExPx. Sem ele (ou curto), a API só aceita o estúdio.
EXPX_SYNC_TOKEN=
# Endereço público usado nos links e nas mensagens de PIN (ex.: https://anajulia.com.br).
PORTAL_PUBLIC_URL=

# Postgres direto (Settings → Database). Percent-encode caracteres especiais da senha.
# Pooler (Vercel / serverless): porta 6543 e user postgres.bkknluhlyqmfhiazwslg
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.bkknluhlyqmfhiazwslg.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.bkknluhlyqmfhiazwslg.supabase.co:5432/postgres
